@page "/Registrar/Cliente"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout Layout.AuthLayout
@using CanchaLibreWeb.ViewModels

<div class="app-auth-shell">
    <div class="brand-container">
        <a href="index.html">
        <img src="Logo.png" alt="Logo" class="logo">
        </a>
        <span class="brand-name">CanchaLibre</span>
    </div>

    <div class="app-auth-card">
        <h1 class="app-title">Registrarse</h1>
        <p class="app-subtitle">Únase a la comunidad de CanchaLibre</p>
        
        <EditForm Model="@Modelo" OnValidSubmit="ProcesarRegistro" FormName="RegClienteForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label-custom">Nombres</label>
                <InputText class="form-input-custom" @bind-Value="Modelo.Nombres" placeholder="Juan Pérez" />
                <ValidationMessage For="@(() => Modelo.Nombres)" class="text-danger small mt-1" />
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Correo electrónico</label>
                <InputText type="email" class="form-input-custom" @bind-Value="Modelo.Correo" placeholder="correo@gmail.com" />
                <ValidationMessage For="@(() => Modelo.Correo)" class="text-danger small mt-1" />
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Contraseña</label>
                <InputText type="password" class="form-input-custom" @bind-Value="Modelo.Contrasena" placeholder="**********" />
                <ValidationMessage For="@(() => Modelo.Contrasena)" class="text-danger small mt-1" />
            </div>

            <div class="mb-4">
                <label class="form-label-custom">Confirmar contraseña</label>
                <InputText type="password" class="form-input-custom" @bind-Value="ConfirmarContrasena" placeholder="**********" />
                @if (!string.IsNullOrEmpty(MensajeError))
                {
                    <div class="text-danger small mt-1">@MensajeError</div>
                }
            </div>

            <button class="btn btn-primary w-100" type="submit">Registrarse</button>
        </EditForm>

        <div class="app-text mt-4">
            ¿Ya tiene una cuenta? <a href="/Login">Inicie sesión</a>
        </div>
    </div>
</div>