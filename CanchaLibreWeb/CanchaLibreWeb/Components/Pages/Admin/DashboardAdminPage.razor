@page "/Admin/Dashboard"
@rendermode InteractiveServer
@attribute [AllowAnonymous]

<div class="d-flex" style="min-height: 100vh; background-color: #F8F9FA;">
    
    <div class="text-white p-4 d-flex flex-column" style="width: 260px; background-color: #1A202C;">
        <div class="text-center mb-5 mt-3">
            <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center mx-auto mb-2" style="width: 70px; height: 70px;">
                <span class="fs-2"><img src="admin.png" alt="Admin" class="img-fluid"></span>
            </div>
            <h5 class="mb-0 fw-bold">Admin</h5>
        </div>

        <div class="nav flex-column nav-pills gap-2">
            <a class="nav-link text-white active style-active-menu" href="/Admin/Dashboard">
                <span class="me-5"></span> Dashboard
            </a>
            <a class="nav-link text-white opacity-75" href="/Admin/Usuarios">
                <span class="me-5"></span> Usuarios
            </a>
            <a class="nav-link text-white opacity-75" href="/Admin/Reportes">
                <span class="me-5"></span> Reportes
            </a>
        </div>

        <a href="/" class="mt-auto text-white-50 text-decoration-none small text-center py-2 border-top border-secondary">
             Volver al Inicio
        </a>
    </div>

    <div class="flex-grow-1 p-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="fw-bold h2 text-dark">Dashboard</h1>
        </div>

        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
                    <p class="text-secondary small fw-bold mb-1">Usuarios totales</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-1 fw-bold text-success">1024</span>
                        <span class="fs-2"><img src="usuarios.png" alt="Usuarios" class="img-fluid"></span>
                    </div>
                    <p class="text-success small mt-2 mb-0 fw-semibold">+ 18% Respecto al mes anterior</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
                    <p class="text-secondary small fw-bold mb-1">Canchas registradas</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-1 fw-bold text-success">1024</span>
                        <span class="fs-2"><img src="ubicacion.png" alt="Canchas" class="img-fluid"></span>
                    </div>
                    <p class="text-success small mt-2 mb-0 fw-semibold">+ 5% Respecto al mes anterior</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
                    <p class="text-secondary small fw-bold mb-1">Reservas del mes</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-1 fw-bold text-success">2048</span>
                        <span class="fs-2"><img src="calendario.png" alt="Reservas" class="img-fluid"></span>
                    </div>
                    <p class="text-success small mt-2 mb-0 fw-semibold">+ 32% Respecto al mes anterior</p>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
                    <p class="text-secondary small fw-bold mb-1">Ingresos totales</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="fs-2 fw-bold text-success">s/.20 mil</span>
                        <span class="fs-2"><img src="ingresos.png" alt="Ingresos" class="img-fluid"></span>
                    </div>
                    <p class="text-success small mt-2 mb-0 fw-semibold">+ 18% Respecto al mes anterior</p>
                </div>
            </div>
        </div>

        <div class="card border-0 shadow-sm p-4 bg-white rounded-4">
            <h5 class="fw-bold text-dark mb-4">Ocupación por horario</h5>
            
            <div class="d-flex align-items-end justify-content-between pt-4 px-2" style="height: 300px; border-bottom: 2px solid #E2E8F0; border-left: 2px solid #E2E8F0; position: relative;">
                
                @foreach (var punto in DatosGrafico)
                {
                    <div class="d-flex flex-column align-items-center flex-grow-1 mx-2" style="max-width: 60px;">
                        <div class="w-100 rounded-top-2 translate-bar-animation" 
                             style="height: @(punto.Porcentaje)px; background-color: #48BE74;" 
                             title="Ocupación: @punto.Porcentaje">
                        </div>
                        <span class="text-secondary mt-2 small fw-semibold" style="font-size: 11px;">@punto.Hora</span>
                    </div>
                }
            </div>
        </div>

    </div>
</div>

<style>
    /* Estilos inyectados específicos para este layout que no chocan con app.css */
    .style-active-menu {
        background-color: #48BE74 !important;
        font-weight: bold;
        border-radius: 8px;
    }
    .translate-bar-animation {
        transition: height 0.5s ease-in-out;
    }
    .translate-bar-animation:hover {
        background-color: #059669 !important;
        cursor: pointer;
    }
</style>