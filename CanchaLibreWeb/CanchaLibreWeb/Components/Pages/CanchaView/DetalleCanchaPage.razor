@page "/cancha/{Id:int}"
@using CanchaLibreWeb.ViewModels

<section class="hero-cancha">
    <div class="navbar-cancha">
        <img src="Logo.png" class="logo-cancha" />
        <span class="brand-name">CanchaLibre</span>

        <div class="menu-cancha">
            <a href="/">Inicio</a>
            <a href="/">Encuentra cancha</a>
            <a href="#">Mis Reservas</a>
            <a href="#">Portal Propietario</a>
            <a href="/login" class="icono-usuario">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="white" viewBox="0 0 24 24">
                    <path d="M12 12c2.7 0 4.8-2.1 4.8-4.8S14.7 2.4 12 2.4 7.2 4.5 7.2 7.2 9.3 12 12 12zm0 2.4c-3.2 0-9.6 1.6-9.6 4.8v2.4h19.2v-2.4c0-3.2-6.4-4.8-9.6-4.8z" />
                </svg>
            </a>
            <a href="/registrar" class="btn-registro">Regístrate</a>
        </div>
    </div>

</section>

<div class="detalle-shell">

    <!-- GALERÍA -->
    <div class="galeria-layout">
        <img class="img-principal" src="@cancha.imagenUrl" alt="@cancha.nombre" />
        <div class="img-miniaturas">
            <!--otras imagenes de la cancha-->
        </div>
    </div>

    <div class="detalle-body">

        <!-- COLUMNA IZQUIERDA -->
        <div class="col-info">

            <div class="info-header">
                <div>
                    <h1>@cancha.nombre</h1>
                    <p class="ubicacion">📍 @cancha.direccion</p>
                </div>
                <span class="badge-deporte">Fútbol</span>
            </div>

            <div class="rating-row">
                <span class="star">★</span>
                <strong>4.7</strong>
                <span class="reviews">(56 reviews)</span>
            </div>

            <div class="meta-row">
                <div><span class="meta-label">Capacidad</span><span class="meta-val">12 jugadores</span></div>
                <div><span class="meta-label">Superficie</span><span class="meta-val">Grass Sintético</span></div>
                <div><span class="meta-label">Propietario</span><span class="meta-val">Juan Pérez</span></div>
            </div>

            <div class="seccion">
                <h3>Descripción</h3>
                <p>@cancha.descripcion</p>
            </div>

            <div class="seccion">
                <h3>Reglas</h3>
                <ul class="reglas-lista">
                    <li>✅ Llegue 10 minutos antes de la hora de su reserva.</li>
                    <li>✅ Se requiere vestimenta y calzado deportivo adecuados.</li>
                    <li>✅ No se permite fumar ni consumir alcohol en las instalaciones.</li>
                    <li>✅ Se permiten cancelaciones hasta 24 horas antes de la reserva.</li>
                </ul>
            </div>

            <!-- COMENTARIOS -->
            <div class="seccion">
                <h2>Comentarios destacados</h2>
                <p class="sub-comentarios">Lo que dicen nuestros clientes de</p>
                <div class="grid-comentarios">
                    @foreach (var c in comentarios)
                    {
                        <div class="card-comentario">
                            <div class="comentario-header">
                                <img src="https://i.pravatar.cc/36?u=@c.Nombre" />
                                <strong>@c.Nombre</strong>
                            </div>
                            <p>@c.Texto</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- COLUMNA DERECHA: RESERVA -->
        <div class="col-reserva">

            <div class="card-reserva">
                <h3>Características</h3>
                <div class="grid-caracteristicas">
                    <span>✅ Floodlights</span>
                    <span>✅ Drinking Water</span>
                    <span>✅ Changing Room</span>
                    <span>✅ Referee</span>
                    <span>✅ Parking</span>
                    <span>✅ Scoreboard</span>
                </div>

                <hr />

                <h3>Fecha y Hora</h3>

                <label class="form-label-custom">Seleccionar fecha</label>
                <input type="date" class="form-input-custom mb-3" @bind="fechaSeleccionada" />

                <label class="form-label-custom">Seleccionar hora</label>
                <div class="grid-horarios">
                    @foreach (var h in horarios)
                    {
                        <button class="btn-horario @(horaSeleccionada == h.Etiqueta ? "activo" : "")"
                                @onclick="() => SeleccionarHora(h)">
                            <span>@h.Etiqueta</span>
                            <small>S/@h.Precio</small>
                        </button>
                    }
                </div>

                <hr />

                <div class="detalle-precio">
                    <div class="precio-fila">
                        <span>1h x S/ 80</span><span>S/ 80</span>
                    </div>
                    <div class="precio-fila">
                        <span>Recarga por servicio</span><span>S/ 5</span>
                    </div>
                    <div class="precio-fila total">
                        <strong>Total</strong><strong>S/ 85</strong>
                    </div>
                </div>

                <button class="btn-reservar-main">Reservar y Pagar</button>
            </div>
        </div>
    </div>
</div>
<footer class="footer-cancha">
    <div class="footer-izquierda">
        <div class="footer-logo">
            <img src="Logo.png" alt="Logo" class="logo-cancha" />
            <span class="brand-name">CanchaLibre</span>
        </div>
        <p class="footer-descripcion">
            Reserva pistas deportivas al instante. Pagos seguros
            mediante Yape y Plin. Compatible con múltiples
            deportes e instalaciones en toda la ciudad.
        </p>
        <p class="footer-copy">
            © 2026 <a href="/">CanchaLibre</a> — Todos los derechos reservados
        </p>
    </div>

    <div class="footer-derecha">
        <h4>Contact us</h4>
        <p>📞 (222) 333-7767</p>
        <p>✉️ support@unknowna.com</p>
        <div class="footer-redes">
            
            <a href="#" aria-label="Facebook">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 24 24">
                    <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
                </svg>
            </a>
            
            <a href="#" aria-label="Twitter">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 24 24">
                    <path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z" />
                </svg>
            </a>
            
            <a href="#" aria-label="Instagram">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="white" viewBox="0 0 24 24">
                    <rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
                    <path fill="#16a34a" d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
                    <line x1="17.5" y1="6.5" x2="17.51" y2="6.5" />
                </svg>
            </a>
        </div>
    </div>
</footer>
