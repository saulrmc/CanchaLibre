<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Components\Resources\DistritoData.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Components\Resources\DistritoData.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazorise.Bootstrap5" Version="2.2.1" />
    <PackageReference Include="Blazorise.Components" Version="2.2.1" />
    <PackageReference Include="Blazorise.Scheduler" Version="2.2.1" />
  </ItemGroup>

</Project>
