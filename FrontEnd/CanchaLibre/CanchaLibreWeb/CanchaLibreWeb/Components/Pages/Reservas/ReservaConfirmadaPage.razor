@page "/ReservaConfirmada/{Id:int}"
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Cliente")]
@using CanchaLibreWeb.ViewModels

<div class="confirmada-shell">
    <div class="confirmada-card">

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger">@mensajeError</div>
        }
        else if (reserva == null)
        {
            <div class="text-center p-5">
                <div class="spinner-border text-success" role="status"></div>
                <p class="mt-2 text-muted">Cargando información de la reserva...</p>
            </div>
        }
        else
        {

        <!-- ÍCONO ÉXITO -->
        <div class="icono-exito">
            <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"
                 stroke-linecap="round" stroke-linejoin="round">
                <polyline points="20 6 9 17 4 12" />
            </svg>
        </div>

        <h1>¡Reserva Confirmada!</h1>
        <p class="subtitulo">Tu reserva ha sido registrada exitosamente</p>

        <!-- DETALLES RESERVA -->
        <div class="seccion-detalle">
            <h2>Detalles de la Reserva</h2>

            <div class="detalle-fila">
                    <span class="detalle-icono"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
                <div>
                    <p class="detalle-principal">@NombreCancha</p>
                    <p class="detalle-secundario">@UbicacionCancha</p>
                </div>
            </div>

            <div class="detalle-fila">
                    <span class="detalle-icono"><i class="fa-solid fa-calendar-days" aria-hidden="true"></i></span>
                <div>
                    <p class="detalle-principal">@FechaFormateada</p>
                    <p class="detalle-secundario">Turno registrado</p>
                </div>
            </div>

            <div class="detalle-fila">
                    <span class="detalle-icono"><i class="fa-solid fa-clock" aria-hidden="true"></i></span>
                <div>
                    <p class="detalle-principal">@HoraRango</p>
                    <p class="detalle-secundario">Duración: @Duracion</p>
                </div>
            </div>
        </div>

        <!-- RESUMEN PAGO -->
        <div class="seccion-detalle">
            <h2>Resumen de Pago</h2>

            @foreach (var item in itemsPago)
            {
                <div class="pago-fila">
                    <span>@item.Concepto</span>
                    <span>S/ @item.Monto.ToString("F2")</span>
                </div>
            }

            <div class="pago-fila total">
                <strong>Total Pendiente</strong>
                <strong class="total-verde">S/ @Total.ToString("F2")</strong>
            </div>

            @if (pagoExitoso)
            {
                <div class="pago-exitoso">
                    <svg viewBox="0 0 24 24" fill="none" stroke="#16a34a" stroke-width="2.5"
                         stroke-linecap="round" stroke-linejoin="round" width="20" height="20">
                        <polyline points="20 6 9 17 4 12" />
                    </svg>
                    Pago realizado con @metodoPagoSeleccionado
                </div>
            }
            else if (mostrarSelectorPago)
            {
                <div class="selector-pago">
                    <h3>Selecciona método de pago</h3>
                    <div class="opciones-pago">
                        <label class="pago-opcion @(metodoPagoSeleccionado == MetodoPagoEnum.YAPE ? "activo" : "")">
                            <input type="radio" name="metodoPago" value="YAPE"
                                   checked="@(metodoPagoSeleccionado == MetodoPagoEnum.YAPE)"
                                   @onchange="() => metodoPagoSeleccionado = MetodoPagoEnum.YAPE" />
                                <span class="pago-icono"><i class="fa-solid fa-mobile-retro"></i></span>
                            <span>YAPE</span>
                        </label>
                        <label class="pago-opcion @(metodoPagoSeleccionado == MetodoPagoEnum.PLIN ? "activo" : "")">
                            <input type="radio" name="metodoPago" value="PLIN"
                                   checked="@(metodoPagoSeleccionado == MetodoPagoEnum.PLIN)"
                                   @onchange="() => metodoPagoSeleccionado = MetodoPagoEnum.PLIN" />
                                <span class="pago-icono"><i class="fa-solid fa-pager"></i></span>
                            <span>PLIN</span>
                        </label>
                    </div>

                    @if (!string.IsNullOrEmpty(mensajePago))
                    {
                        <div class="alert alert-danger mt-2">@mensajePago</div>
                    }

                    <div class="pago-acciones">
                        <button class="btn-confirmar-pago" @onclick="PagarReserva" disabled="@procesandoPago">
                            @(procesandoPago ? "Procesando..." : $"Pagar S/ {Total:F2}")
                        </button>
                        <button class="btn-cancelar-pago" @onclick="CancelarPago" disabled="@procesandoPago">Cancelar</button>
                    </div>
                </div>
            }
            else
            {
                <div class="metodo-pago">
                    @if (reserva?.pago?.idPago > 0)
                    {
                            <span><i class="fa-solid fa-circle-check" style="color: rgb(99, 230, 190);"></i> Pagado con @reserva.pago.metodoPago — S/ @reserva.pago.monto.ToString("F2")</span>
                    }
                    else
                    {
                            <span><i class="fa-solid fa-pager"></i>Pendiente de pago</span>
                    }
                </div>

                @if (reserva?.estado == EstadoReservaEnum.PENDIENTE_PAGO)
                {
                    <button class="btn-pagar-ahora" @onclick="MostrarPago">
                        Pagar ahora
                    </button>
                }
            }
        </div>

        @if (!mostrarSelectorPago)
        {
        <!-- CÓDIGO RESERVA -->
        <div class="codigo-reserva">
            <p class="codigo-label">Código de Reserva</p>
            <p class="codigo-valor">@CodigoReserva</p>
            <p class="codigo-hint">Presente este código al llegar a la cancha</p>
        </div>

        <!-- BOTONES -->
        <div class="acciones">
            <button class="btn-inicio" @onclick="VolverInicio">
                 Volver al Inicio
            </button>
        </div>
        }

        }
    </div>
    <ToastReservaExitosa Mostrar="mostrarToast"
                         Titulo="¡Reserva confirmada!"
                         Mensaje="@($"Tu reserva en {NombreCancha} se realizó con éxito.")" />
</div>