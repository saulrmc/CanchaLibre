@page "/Cancha/{Id:int}"
@rendermode InteractiveServer
@using CanchaLibreWeb.ViewModels
@using CanchaLibreWeb.Servicios.Canchas
@using CanchaLibreWeb.Servicios.Reservas
@using CanchaLibreWeb.Servicios.Usuarios
@using Microsoft.AspNetCore.Components.Authorization
@attribute [AllowAnonymous]

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger m-3">@mensajeError</div>
}

@if (cancha == null)
{
    <div class="text-center p-5">
        <div class="spinner-border text-success" role="status"></div>
        <p class="mt-2 text-muted">Cargando cancha...</p>
    </div>
}
else
{
    <div class="detalle-shell">
        <div class="galeria-layout">
            <img class="img-principal" src="@(string.IsNullOrEmpty(cancha.imagenUrl) ? "default-cancha.jpg" : cancha.imagenUrl)" alt="@cancha.nombre" />
            <div class="img-miniaturas">
                <img src="@cancha.imagenUrl" alt="Miniatura" />
            </div>
        </div>

        <div class="detalle-body">
            <div class="col-info">
                <div class="info-header">
                    <div>
                        <h1>@cancha.nombre</h1>
                        <p class="ubicacion">📍 @cancha.direccion</p>
                    </div>

                    <div class="d-flex gap-1">
                        @if (cancha.deportes != null)
                        {
                            @foreach (var deporte in cancha.deportes)
                            {
                                var nombreDeporte = deporte.ToString();

                                <span class="badge mb-1 @(nombreDeporte == "Fútbol" ? "bg-purple-badge" :
                                                          nombreDeporte == "Voley" ? "bg-blue-badge" :
                                                          nombreDeporte == "Basquet" ? "bg-pink-badge" :
                                                          "bg-orange-badge")">
                                    @nombreDeporte
                                </span>
                            }
                        }
                    </div>
                </div>

                <div class="rating-row">
                    <span class="star">★</span>
                    <strong>@cancha.promedioCalificacion.ToString("0.0")</strong>
                    <span class="reviews">(Calificación promedio)</span>
                </div>

                <div class="meta-row">
                    <div>
                        <span class="meta-label">Precio Base</span>
                        <span class="meta-val">S/ @cancha.precioBase</span>
                    </div>
                    <div>
                        <span class="meta-label">Estado</span>
                        <span class="meta-val text-success">@(cancha.activo ? "Disponible" : "Mantenimiento")</span>
                    </div>
                    <div>
                        <span class="meta-label">Propietario</span>
                        <span class="meta-val">@(cancha.propietario?.Nombres ?? "Administrador General")</span>
                    </div>
                </div>

                <div class="seccion">
                    <h3>Descripción</h3>
                    <p>@cancha.descripcion</p>
                </div>

                <div class="seccion">
                    <h3>Reglas del Complejo</h3>
                    <ul class="reglas-lista">
                        @if (ReglasSeparadas != null && ReglasSeparadas.Any())
                                {
                                    @foreach (var regla in ReglasSeparadas)
                                    {
                                        <li>✅ @regla</li>
                                    }
                                }
                        else
                        {
                        <li>✅ Llegue 10 minutos antes de la hora de su reserva.</li>
                        <li>✅ Se requiere vestimenta y calzado deportivo adecuados.</li>
                        <li>✅ No se permite fumar ni consumir alcohol en las instalaciones.</li>
                        }
                    </ul>
                </div>

                <div class="seccion">
                    <h2>Comentarios </h2>
                    <p class="sub-comentarios">Lo que dicen nuestros clientes</p>
                    <div class="grid-comentarios">
                        @foreach (var c in comentarios)
                        {
                            <div class="card-comentario">
                                <div class="comentario-header">
                                    <img src="https://i.pravatar.cc/36?u=@c.Nombre" alt="Avatar" />
                                    <strong>@c.Nombre</strong>
                                </div>
                                <p>@c.Texto</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-reserva">
                <div class="card-reserva">
                    <h3>Características</h3>
                    <div class="grid-caracteristicas">
                        @if (cancha.etiquetas != null && cancha.etiquetas.Any())
                        {
                            @foreach (var etiqueta in cancha.etiquetas)
                            {
                                <span>✅ @etiqueta.ToString().Replace("_", " ")</span>
                            }
                        }
                        else
                        {
                            <span class="text-muted small">Servicios básicos estándar</span>
                        }
                    </div>

                    <hr />

                    <h3>Fecha y Hora</h3>

                    <label class="form-label-custom">Seleccionar fecha</label>
                    <input type="date" class="form-input-custom mb-3" 
                           min="@DateTime.Today.ToString("yyyy-MM-dd")" 
                           @bind="FechaSeleccionada" @bind:event="onchange" />

                    <label class="form-label-custom">Horarios disponibles (@DiaSeleccionadoTexto)</label>
                    <div class="grid-horarios">
                        @if (BloquesFiltrados != null && BloquesFiltrados.Any())
                        {
                            @foreach (var bloque in BloquesFiltrados)
                            {
                                var etiquetaHora = $"{bloque.horaInicio:HH:mm} - {bloque.horaFin:HH:mm}";
                                <button type="button" class="btn-horario @(bloqueSeleccionado == bloque ? "activo" : "")"
                                        @onclick="() => SeleccionarBloque(bloque)">
                                    <span>@etiquetaHora</span>
                                    <small>S/ @bloque.precio</small>
                                </button>
                            }
                           
                        }
                        @* else
                        {
                            <div class="col-span-2 text-center text-muted small py-3">
                                No hay bloques configurados para este día.
                            </div>
                        } *@
                         
                    </div>
                    <div class="detalle-precio">
                            <div class="precio-fila">
                                <span>Subtotal Cancha</span>
                                <span>S/ @PrecioSubtotal</span>
                            </div>
                            <div class="precio-fila">
                                <span>Recarga por servicio</span>
                                <span>S/ @CostoServicio</span>
                            </div>
                            <div class="precio-fila total">
                                <strong>Total</strong>
                                <strong>S/ @PrecioTotal</strong>
                            </div>
                        </div>
                        @if(cancha.activo == true){
                            <button class="btn-reservar-main" disabled="@(bloqueSeleccionado == null)" @onclick="IrAPagar">
                                Reservar y Pagar
                            </button>
                        }
                    <hr />

                    
                </div>
            </div>
        </div>
    </div>
}