@page "/EncuentraCancha"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@using CanchaLibreWeb.ViewModels

<div class="encuentra-shell">
    <div class="encuentra-header">
        <div>
            <h1>Encuentra tu Cancha</h1>
            <p>Selecciona el complejo deportivo ideal para tu próximo partido:</p>
        </div>

        <div class="filtro-orden">
            <label>Ordenar por:</label>
            <select @bind="ordenSeleccionado" @bind:after="Ordenar">
                <option value="precio_asc">Menor precio</option>
                <option value="precio_desc">Mayor precio</option>
                <option value="nombre">Nombre alfabético</option>
            </select>
        </div>
    </div>

    <div class="encuentra-body">
        <!-- SIDEBAR DE FILTROS -->
        <aside class="sidebar-filtros">
            <div class="filtro-grupo">
                <h4><i class="ti ti-filter"></i> Tipo de Deporte</h4>
                @foreach (var d in deportesDisponibles)
                {
                    <label class="check-label">
                        <input type="checkbox" checked="@deportesSeleccionados.Contains(d)" @onchange="e => ToggleDeporte(d, e)" />
                        @FormatearEnumTexto(d.ToString())
                    </label>
                }
            </div>

            <div class="filtro-grupo">
                <h4>Rango de Precio Máximo (S/)</h4>
                <input type="range" min="0" max="300" step="10"
                       @bind="precioMax" @bind:after="AplicarFiltros" />
                <div class="precio-range-labels">
                    <span>S/ 0</span><strong>S/ @precioMax</strong>
                </div>
            </div>

            <div class="filtro-grupo">
                <h4>Características</h4>
                @foreach (var c in caracteristicasDisponibles)
                {
                    <label class="check-label">
                        <input type="checkbox" checked="@caracteristicasSeleccionadas.Contains(c)" @onchange="e => ToggleCaracteristica(c, e)" />
                        @FormatearEnumTexto(c.ToString())
                    </label>
                }
            </div>

            <button class="btn-limpiar" @onclick="LimpiarFiltros">Limpiar todos los filtros</button>
        </aside>

        <!-- CONTENEDOR DE TARJETAS -->
        <div class="grid-canchas">
            @if (canchasFiltradas == null)
            {
                <div class="text-center p-5 w-100">
                    <div class="spinner-border text-success" role="status"></div>
                    <p class="mt-2 text-muted">Consultando canchas disponibles...</p>
                </div>
            }
            else if (!canchasFiltradas.Any())
            {
                <div class="text-center p-5 w-100 text-muted">
                    <p>No se encontraron complejos deportivos que coincidan con los filtros seleccionados.</p>
                </div>
            }
            else
            {
                @foreach (var cancha in canchasFiltradas)
                {
                    <div class="card-cancha">
                        <img src="@(string.IsNullOrEmpty(cancha.imagenUrl) ? "default-cancha.jpg" : cancha.imagenUrl)" alt="@cancha.nombre" />

                        <div class="card-body">
                            <h3>@cancha.nombre</h3>
                            <p class="card-ubicacion"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i>@cancha.direccion</p>

                            <p class="card-precio">
                                <strong>S/ @cancha.precioBase</strong> <span>precio base</span>
                            </p>

                            <!-- CARACTERÍSTICAS/ETIQUETAS -->
                            <div class="card-etiquetas">
                                @if (cancha.etiquetas != null)
                                {
                                    @foreach (var e in cancha.etiquetas)
                                    {
                                        <span class="etiqueta-chip">@FormatearEnumTexto(e.ToString())</span>
                                    }
                                }
                            </div>

                            <!-- DEPORTES -->
                            <div class="card-deportes">
                                @if (cancha.deportes != null)
                                {
                                    @foreach (var d in cancha.deportes)
                                    {
                                        <span class="deporte-chip @ObtenerColorDeporte(d)">
                                            @FormatearEnumTexto(d.ToString())
                                        </span>
                                    }
                                }
                            </div>

                            <a class="btn-reservar" href="/cancha/@cancha.id">
                                Reservar cancha
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>