@page "/PortalPropietario/Publicar"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Forms
@using CanchaLibreWeb.ViewModels

@*@attribute [AllowAnonymous]*@
@attribute [Authorize(Roles = "Propietario")]

<div class="bg-light py-5" style="min-height: 80vh;">
    <div class="container py-5" style="max-width: 850px;">

        <div class="wizard-steps-container">
            <div class="wizard-steps-flex px-md-5">
                <div class="step-line"></div>
                <div class="text-center z-index-1">
                    <div class="step-number @(PasoActual >= 1 ? "step-active" : "")">1</div>
                    <span class="small fw-bold text-secondary d-none d-md-block mt-2">Datos Básicos</span>
                </div>
                <div class="text-center z-index-1">
                    <div class="step-number @(PasoActual >= 2 ? "step-active" : "")">2</div>
                    <span class="small fw-bold text-secondary d-none d-md-block mt-2">Ubicación y Extras</span>
                </div>
                <div class="text-center z-index-1">
                    <div class="step-number @(PasoActual >= 3 ? "step-active" : "")">3</div>
                    <span class="small fw-bold text-secondary d-none d-md-block mt-2">Disponibilidad</span>
                </div>
                <div class="text-center z-index-1 user-select-none">
                    <div class="step-number @(PasoActual >= 4 ? "step-active" : "")">4</div>
                    <span class="small fw-bold text-secondary d-none d-md-block mt-2">Reglas y Pago</span>
                </div>
            </div>
        </div>

        <div class="form-container-card">
            <EditForm EditContext="@FormContext" FormName="PublicarCanchaForm">
                <DataAnnotationsValidator />

                @if (PasoActual == 1)
                {
                    <h4 class="fw-bold text-dark mb-4">Paso 1: Cuéntanos sobre tu cancha</h4>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Nombre de la Cancha / Complejo</label>
                        <InputText
                            class="form-control bg-light py-2 px-3 border-0 rounded-3 text-dark custom-input"
                            @bind-Value="Modelo.nombre"
                            placeholder="Ej. Complejo Deportivo Ciro Alegría" />
                        <ValidationMessage For="@(() => Modelo.nombre)" class="text-danger small mt-1" />
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Deporte Principal</label>
                            <select class="form-select bg-light py-2 px-3 border-0 rounded-3 text-dark custom-input"
                                    @bind="DeporteSeleccionado">
                                @foreach (var deporte in DeportesDisponibles)
                                {
                                    <option value="@deporte">@deporte</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-secondary">Precio por hora (S/.)</label>
                            <InputNumber class="form-control bg-light py-2 px-3 border-0 rounded-3 text-dark custom-input"
                                         @bind-Value="Modelo.precioBase" onclick="this.select();" />
                            <ValidationMessage For="@(() => Modelo.precioBase)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Descripción para los jugadores</label>
                        <InputTextArea rows="4"
                            class="form-control bg-light py-2 px-3 border-0 rounded-3 text-dark custom-input"
                            @bind-Value="Modelo.descripcion"
                            placeholder="Césped artificial de alta calidad que cumple con los estándares internacionales..." />
                        <ValidationMessage For="@(() => Modelo.descripcion)" class="text-danger small mt-1" />
                    </div>
                }

                else if (PasoActual == 2)
                {
                    <h4 class="fw-bold text-dark mb-4">Paso 2: ¿Dónde está ubicada y qué incluye?</h4>

                    <div class="row g-3 mb-4">
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-secondary">Distrito</label>
                            <div @onchange="RefrescarValidacionDistrito" @onclick="RefrescarValidacionDistrito">
                                <SelectorDistrito @bind-DistritoSeleccionado="Modelo.distrito" />
                            </div>

                            <ValidationMessage For="@(() => Modelo.distrito)" class="text-danger small mt-1" />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label small fw-bold text-secondary">Dirección Exacta</label>
                            <InputText class="form-control bg-light py-2 px-3 border-0 rounded-3 text-dark custom-input"
                                       @bind-Value="Modelo.direccion" placeholder="Av. Próceres de la Independencia 123" />
                            <ValidationMessage For="@(() => Modelo.direccion)" class="text-danger small mt-1" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary d-block mb-3">Características del establecimiento</label>
                        <div class="row g-3">
                            @foreach (var item in CaracteristicasDisponibles)
                            {
                                <div class="col-6 col-md-4">
                                    <div class="p-3 bg-light rounded-3 d-flex align-items-center gap-3 feature-card @(item.Seleccionado ? "feature-active" : "")"
                                         @onclick="() => {
                                             item.Seleccionado = !item.Seleccionado;
                                             if (item.Seleccionado) CaracteristicasCopia.Add(item.Nombre);
                                             else CaracteristicasCopia.Remove(item.Nombre); }">
                                        <span class="fs-4">@item.Icono</span>
                                        <span class="small fw-semibold text-dark">@item.Nombre</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else if (PasoActual == 3)
                {
                    <h4 class="fw-bold text-dark mb-4">Paso 3: ¿Cuándo está disponible?</h4>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary d-block mb-3">Selecciona los días y horarios de disponibilidad</label>

                        <div class="d-flex align-items-center gap-3 mb-4">
                            <div class="d-flex align-items-center gap-1">
                                <span class="indicador-color activo"></span>
                                <span class="small text-secondary fw-semibold">Disponible</span>
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                <span class="indicador-color inactivo"></span>
                                <span class="small text-secondary fw-semibold">No disponible</span>
                            </div>
                        </div>

                        <p class="text-muted small mt-2 mb-4 bg-light p-2 rounded border-start border-success border-3">
                            ⚽ <strong>Tip pro:</strong> Por defecto se aplica tu precio base. Puedes usar bloques individuales para ajustar tarifas especiales en horarios nocturnos (por costos de iluminación) o fines de semana.
                        </p>

                        <div class="table-responsive contenedor-matriz-fina">
                            <table class="table table-bordered tabla-horarios-custom m-0">
                                <thead>
                                    <tr>
                                        <th class="columna-hora-header">Hora</th>
                                        @foreach (DiaSemanaEnum dia in Enum.GetValues(typeof(DiaSemanaEnum)))
                                        {
                                            if (dia != DiaSemanaEnum.NO_VALIDO)
                                            {
                                                <th>@dia.ToString()</th>
                                            }
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (int h = 6; h <= 23; h++)
                                    {
                                        var horaFija = new TimeOnly(h, 0);
                                        <tr>
                                            <td class="celda-hora">@horaFija.ToString("hh:mm tt")</td>

                                            @foreach (DiaSemanaEnum dia in Enum.GetValues(typeof(DiaSemanaEnum)))
                                            {
                                                if (dia != DiaSemanaEnum.NO_VALIDO)
                                                {
                                                    var bloqueExistente = ObtenerBloque(dia, horaFija);

                                                    <td class="celda-slot @(bloqueExistente != null ? "slot-activo" : "")"
                                                        @onclick="() => ToggleSlot(dia, horaFija)">
                                                        @if (bloqueExistente != null)
                                                        {
                                                            <div class="wrapper-info-slot">
                                                                <span class="icono-check">✓</span>
                                                                <span class="texto-precio">S/.@bloqueExistente.precio</span>
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <span class="icono-mas">+</span>
                                                        }
                                                    </td>
                                                }
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-2">
                            <ValidationMessage For="@(() => HorariosSeleccionados)" class="text-danger small fw-semibold" />
                        </div>
                    </div>

                    @if (mostrarModalPrecio && bloqueAEditar != null)
                    {
                        <div class="custom-modal-backdrop" @onclick="CerrarModal">
                            <div class="custom-mini-modal" @onclick:stopPropagation="true">
                                <div class="modal-header-custom">
                                    <h6 class="m-0 fw-bold text-dark">
                                        Ajustar Tarifa (@bloqueAEditar.diaSemana - @bloqueAEditar.horaInicio.ToString("hh:mm tt"))
                                    </h6>
                                </div>
                                <div class="modal-body-custom my-3">
                                    <label class="form-label small text-secondary fw-semibold">Precio para este bloque (S/.):</label>
                                    <input type="number" class="form-control form-control-sm" @bind="nuevoPrecioInput" autofocus />
                                </div>
                                <div class="d-flex justify-content-between gap-2 mt-4">
                                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="EliminarBloqueIndividual">
                                        Desactivar Hora
                                    </button>
                                    <div class="d-flex gap-2">
                                        <button type="button" class="btn btn-sm btn-light border" @onclick="CerrarModal">Cancelar</button>
                                        <button type="button" class="btn btn-sm btn-success px-3" @onclick="GuardarPrecioIndividual">Guardar</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }

                }
                else if (PasoActual == 4)
                {
                    <h4 class="fw-bold text-dark mb-4">Paso 4: Normas y confirmación</h4>

                    <label class="upload-zone mb-4 p-4 rounded-4 bg-light border border-dashed text-center d-block position-relative" style="cursor: pointer;">

                            <InputFile class="upload-input d-none"
                                       OnChange="CargarImagen"
                                       accept=".jpg,.jpeg,.png,image/jpeg,image/png" />

                            @if (string.IsNullOrWhiteSpace(VistaPreviaImagenUrl))
                            {
                                <div class="py-3">
                                    <span class="display-4 text-success d-block mb-2">📸</span>
                                    <h6 class="fw-bold text-dark mb-1">Sube las fotos de tus campos deportivos</h6>
                                    <p class="text-secondary small mb-0">Haz clic aquí para subir una imagen (.jpg, .png)</p>
                                </div>
                            }
                            else
                            {
                                <div class="py-2">
                                    <img src="@VistaPreviaImagenUrl" class="upload-preview rounded-3 img-fluid mb-2 shadow-sm" style="max-height: 200px; object-fit: cover;" alt="Vista previa de la cancha" />
                                    <p class="text-success small fw-bold mt-2 mb-0">✓ Imagen cargada correctamente</p>
                                </div>
                            }
                        </label>

                        @if (!string.IsNullOrWhiteSpace(MensajeImagen))
                        {
                            <div class="alert alert-warning py-2 px-3 small rounded-3 mb-3 fw-bold" role="alert">
                                ⚠️ @MensajeImagen
                            </div>
                        }

                        <div class="mb-4">
                            <ValidationMessage For="@(() => Modelo.imagenUrl)" class="text-danger small fw-semibold" />
                        </div>

                    <div class="mb-4">
                        <label class="form-label small fw-bold text-secondary">Reglas internas del Complejo</label>
                        <InputTextArea rows="3" class="form-control bg-light py-2 px-3 border-0 rounded-3 text-dark custom-input" @bind-Value="ReglasInternas" />
                    </div>

                    <div class="preview-box p-3 border rounded-3 bg-white mb-4 shadow-sm">
                        <div class="row align-items-center">
                            <div class="col-md-3">
                                <div class="bg-secondary text-white text-center py-4 rounded-3 fw-bold small">VISTA PREVIA</div>
                            </div>
                            <div class="col-md-9 mt-2 mt-md-0">
                                <span class="badge mb-1 @(DeporteSeleccionado == "Fútbol" ? "bg-purple-badge" :
                                                          DeporteSeleccionado == "Voley" ? "bg-blue-badge" :
                                                          DeporteSeleccionado == "Basquet" ? "bg-pink-badge" :
                                                            "bg-orange-badge")">
                                    @DeporteSeleccionado
                                </span>
                                <h5 class="fw-bold text-dark mb-1">@(string.IsNullOrEmpty(Modelo.nombre) ? "Nombre de tu Complejo" : Modelo.nombre)</h5>
                                <p class="text-secondary small mb-0">📍 @(string.IsNullOrEmpty(Modelo.direccion) ? "Dirección" : Modelo.direccion) - @(string.IsNullOrEmpty(Modelo.distrito) ? "Ubicación" : Modelo.distrito) • <span class="text-success fw-bold">S/ @Modelo.precioBase por hora</span></p>
                            </div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(MensajeError))
                    {
                        <div class="alert alert-danger small rounded-3 p-2 mb-3" role="alert">
                            ⚠️ @MensajeError
                        </div>
                    }
                }

                else if (PasoActual == 5)
                {
                    <div class="text-center py-5">
                        <span class="display-1 text-success d-block mb-4">🎉</span>
                        <h2 class="fw-bold text-dark">¡Tu cancha ya está al toque!</h2>
                        <p class="text-secondary px-md-5">Felicidades, la publicación se procesó con éxito. Los usuarios de CanchaLibre ya pueden verla y agendar turnos de reserva desde este momento.</p>
                        <a href="/EncuentraCancha" class="btn btn-success px-4 py-2.5 fw-bold mt-3 shadow-sm" style="background-color: #10B981; border: none; border-radius: 8px;">
                            Ir al Buscador de Canchas
                        </a>
                    </div>
                }

                @if (PasoActual <= 4)
                {
                    <div class="d-flex @(PasoActual > 1 ? "justify-content-between" : "justify-content-end") pt-4 border-top mt-5">
                        @if (PasoActual > 1)
                        {
                            <button type="button" class="btn btn-outline-secondary py-2 px-4 rounded-3" @onclick="PasoAnterior" disabled="@IsLoading">
                                Atrás
                            </button>
                        }

                        @if (PasoActual < 4)
                        {
                            <button type="button" class="btn text-white py-2 px-4 rounded-3 fw-bold" style="background-color: #10B981; border: none;" @onclick="SiguientePaso">
                                Siguiente
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn text-white py-2 px-4 rounded-3 fw-bold" style="background-color: #10B981; border: none;" @onclick="ProcesarPublicacionFinal" disabled="@IsLoading">
                                @if (IsLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>Publicando...</span>
                                }
                                else
                                {
                                    <span>Publicar Cancha</span>
                                }
                            </button>
                        }
                    </div>
                }
            </EditForm>
        </div>

    </div>
</div>