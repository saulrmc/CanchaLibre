@page "/"
@rendermode InteractiveServer

@using CanchaLibreWeb.ViewModels
@using CanchaLibreWeb.Servicios.Canchas
@inject ICanchasServiceClient CanchasService
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@using System.Security.Claims

<section class="hero-cancha">

    <div class="hero-texto">
        <h1>Encuentra tu <br>cancha al toque</h1>
    </div>

        <div class="buscador-cancha">
            <div class="inputs-inline-container">
            <!-- Columna 1: Distrito -->
            <div class="seccion-input-home">
                <label>Distrito</label>
                <div class="input-contenedor-blazor">
                    <SelectorDistrito @bind-DistritoSeleccionado="filtroDistrito" />
                </div>
            </div>

        
            <!-- Columna 2: Dirección / Palabra clave -->
            <div class="seccion-input-home">
                <label>¿Qué buscas?</label>
                <input type="text" @bind="filtroDireccion" placeholder="Dirección o nombre del complejo..." />
            </div>
        </div>
        <!-- Acción única de envío -->
        <button @onclick="Buscar">Buscar</button>
    </div>
</section>

<section class="contenido-home">
    <div class="titulo-home">
        <div>
            <h2>Canchas destacadas</h2>
            <p>Reserva los mejores establecimientos deportivos cerca de ti</p>
        </div>
        <a class="btn-ver-todo" href="/EncuentraCancha" @onclick="VerTodo" @onclick:preventDefault>Ver todo</a>
    </div>

    <div class="grid-canchas">
        @if (canchasFiltradas == null)
        {
            <p>Cargando canchas...</p>
        }
        else if (!canchasFiltradas.Any())
        {
            <p>No se encontraron canchas que coincidan con tu búsqueda.</p>
        }
        else
        {
            @foreach (var cancha in canchasFiltradas)
            {
                <div class="card-cancha">
                    <img src="@cancha.imagenUrl" alt="@cancha.nombre" />
                    <div class="card-body-cancha">
                        <h3>@cancha.nombre</h3>
                        <p class="ubicacion"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i> @cancha.direccion</p>
                        <p class="precio"><strong>S/ @cancha.precioBase</strong> <span>por hora</span></p>
                        <div class="etiquetas-card">
                            @if (cancha.etiquetas != null)
                            {
                                @foreach (var etiqueta in cancha.etiquetas.Take(2))
                                {
                                    <span>@etiqueta</span>
                                }
                            }
                        </div>
                        <a class="btn-reservar" href="/cancha/@cancha.id">Reservar</a>
                    </div>
                </div>
            }
        }
    </div>
</section>

@if (mostrarPublicaCancha)
{
<section class="publica-cancha">
    <div>
        <h2>¿Tienes un<br>complejo deportivo?</h2>
        <p>Regístralo en CanchaLibre y gestiona tus reservas de forma rápida y sencilla.</p>
    </div>
    <button @onclick="IrAPublicarCancha">Publicar ahora</button>
</section>
}

@code {
    protected string filtroDistrito { get; set; } = string.Empty;
    protected string filtroDireccion { get; set; } = string.Empty;
    private string deporteSeleccionado = string.Empty;

    private List<CanchaViewModel> _canchasMaestras = new();
    private List<CanchaViewModel> canchasFiltradas = new();
    private bool mostrarPublicaCancha;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var usuario = authState.User;

            if (!usuario.Identity?.IsAuthenticated ?? true)
            {
                mostrarPublicaCancha = true;
            }
            else
            {
                var rol = usuario.FindFirst("Rol")?.Value
                       ?? usuario.FindFirst(ClaimTypes.Role)?.Value
                       ?? string.Empty;
                mostrarPublicaCancha = rol.Trim().Equals("PROPIETARIO", StringComparison.OrdinalIgnoreCase);
            }

            _canchasMaestras = await Task.Run(() => CanchasService.Listar());
            canchasFiltradas = _canchasMaestras;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error al conectar con el backend: {ex.Message}");
        }
    }

    private void Buscar()
    {
        canchasFiltradas = _canchasMaestras
            .Where(c =>
                string.IsNullOrWhiteSpace(filtroDistrito) ||
                (c.distrito?.Contains(filtroDistrito, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(c =>
                string.IsNullOrWhiteSpace(filtroDireccion) ||
                (c.direccion?.Contains(filtroDireccion, StringComparison.OrdinalIgnoreCase) ?? false) ||
                (c.nombre?.Contains(filtroDireccion, StringComparison.OrdinalIgnoreCase) ?? false))
            .Where(c =>
                string.IsNullOrWhiteSpace(deporteSeleccionado) ||
                (c.deportes != null && c.deportes.Any(d =>
                    d.ToString().Equals(deporteSeleccionado, StringComparison.OrdinalIgnoreCase))))
            .ToList();
    }

    protected void VerTodo() => NavigationManager.NavigateTo("/EncuentraCancha");
 private async Task IrAPublicarCancha()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var usuario = authState.User;

        if (usuario.Identity is null || !usuario.Identity.IsAuthenticated)
        {
            NavigationManager.NavigateTo("/Registrar");
            return;
        }

        var valorRolClaim = usuario.FindFirst("Rol")?.Value 
                        ?? usuario.FindFirst("rol")?.Value;

        if (!string.IsNullOrEmpty(valorRolClaim))
        {
            string limpio = valorRolClaim.Trim().ToUpperInvariant();

            if (limpio == "PROPIETARIO" || limpio == "2")
            {
                NavigationManager.NavigateTo("/PortalPropietario/Publicar");
                return;
            }
        }

    }
}