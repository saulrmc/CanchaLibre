@page "/Admin/Usuarios"
@layout Layout.AdminLayout  
@rendermode InteractiveServer
@attribute [Authorize(Roles = "Admin")]

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold h2 text-dark mb-0">Usuarios</h1>
    <a class="btn btn-success px-4 py-2 fw-bold" style="background-color: #48BE74; border: none;" target="_blank" href="@UrlReporteUsuarios">
        Descargar Reporte
    </a>
</div>

@if (!string.IsNullOrEmpty(mensajeError))
{
    <div class="alert alert-danger py-2 small mb-4">@mensajeError</div>
}

@if (!datosCargados)
{
    <div class="d-flex justify-content-center align-items-center py-5">
        <div class="spinner-border text-success" role="status">
            <span class="visually-hidden">Cargando...</span>
        </div>
    </div>
}

@if (datosCargados)
{

<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
            <p class="text-secondary small fw-bold mb-1">Clientes totales</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-1 fw-bold text-success">@totalClientes</span>
                <span class="fs-2 text-success"><img src="cliente.png" alt="Clientes" style="width: 100%; height: 100%; object-fit: contain;" /></span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
            <p class="text-secondary small fw-bold mb-1">Propietarios totales</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-1 fw-bold text-success">@totalPropietarios</span>
                <span class="fs-2 text-success"><img src="propietario.png" alt="Propietarios" style="width: 100%; height: 100%; object-fit: contain;" /></span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
            <p class="text-secondary small fw-bold mb-1">Con actividad reciente</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-1 fw-bold text-success">@actividadReciente</span>
                <span class="fs-2 text-success"><img src="historial.png" alt="Historial" style="width: 100%; height: 100%; object-fit: contain;" /></span>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
            <p class="text-secondary small fw-bold mb-1">Bloqueados</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-1 fw-bold text-success">@bloqueados</span>
                <span class="fs-2 text-success"><img src="Bloqueado.png" alt="Bloqueados" style="width: 100%; height: 100%; object-fit: contain;" /></span>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 bg-white rounded-4 mb-4">
    <div class="row g-3 align-items-end">
        <div class="col-md-5">
            <label class="form-label small fw-bold text-success mb-2">Búsqueda</label>
            <div class="input-group">
                <span class="input-group-text bg-light border-end-0 text-muted"><img src="ubicacion.png" alt="Lupa" style="width: 60%; height: 60%; object-fit: contain;" /></span>
                <input type="text" class="form-control bg-light border-start-0 py-2" 
                       placeholder="Buscar por nombre, correo o RUC" 
                       @bind="TextoBusqueda" />
            </div>
        </div>
        <div class="col-md-3">
            <label class="form-label small fw-bold text-success mb-2">Tipo de usuario</label>
            <select class="form-select bg-light py-2" @bind="FiltroTipo">
                <option value="Todos">Todos</option>
                <option value="Cliente">Cliente</option>
                <option value="Propietario">Propietario</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small fw-bold text-success mb-2">Estado</label>
            <select class="form-select bg-light py-2" @bind="FiltroEstado">
                <option value="Todos">Todos</option>
                <option value="Activo">Activo</option>
                <option value="Bloqueado">Bloqueado</option>
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-success w-100 py-2 fw-bold" style="background-color: #48BE74; border: none;" @onclick="FiltrarUsuarios">
                Buscar
            </button>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4 overflow-hidden bg-white">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0 text-center">
            <thead class="table-light text-secondary small fw-bold">
                <tr>
                    <th class="py-3">Id</th>
                    <th class="py-3 text-start ps-5">Usuario</th>
                    <th class="py-3">Tipo</th>
                    <th class="py-3">Última actividad</th>
                    <th class="py-3">Estado</th>
                    <th class="py-3">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (!UsuariosFiltrados.Any())
                {
                    <tr>
                        <td colspan="6" class="py-5 text-muted">No se encontraron usuarios con los filtros seleccionados.</td>
                    </tr>
                }
                else
                {
                    @foreach (var usuario in UsuariosFiltrados)
                    {
                        <tr style="border-bottom: 1px solid #EDF2F7;">
                            <td class="py-3 fw-semibold text-secondary">@usuario.Id</td>
                            <td class="py-3 text-start ps-5">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle bg-light d-flex align-items-center justify-content-center border" style="width: 42px; height: 42px;">
                                        <span class="fs-5"><img src="usuario.png" alt="Usuario" style="width: 100%; height: 100%; object-fit: contain;" /></span>
                                    </div>
                                    <div>
                                        <div class="fw-bold text-dark" style="font-size: 14px;">@usuario.Nombre</div>
                                        <div class="text-secondary small" style="font-size: 12px;">@usuario.Identificador</div>
                                    </div>
                                </div>
                            </td>
                            <td class="py-3 text-secondary" style="font-size: 14px;">@usuario.Tipo</td>
                            <td class="py-3 text-secondary" style="font-size: 14px;">@usuario.UltimaActividad</td>
                            <td class="py-3">
                                <span class="badge px-3 py-2 rounded-pill small @(usuario.Estado == "Activo" ? "bg-success-subtle text-success" : "bg-danger-subtle text-danger")" style="font-size: 12px;">
                                    @usuario.Estado
                                </span>
                            </td>
                            <td class="py-3">
                                <button class="btn btn-link text-dark p-0 border-0 fs-4 text-decoration-none fw-bold">⋮</button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

}

<style>
    .bg-success-subtle {
        background-color: #E6F4EA !important;
        color: #137333 !important;
    }
    .bg-danger-subtle {
        background-color: #FCE8E6 !important;
        color: #C5221F !important;
    }
</style>
