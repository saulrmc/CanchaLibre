@page "/Admin/Dashboard"
@page "/Admin"
@layout Layout.AdminLayout  
@rendermode InteractiveServer
@* @attribute [AllowAnonymous] *@
@attribute [Authorize(Roles = "Admin")]

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="fw-bold h2 text-dark">Dashboard</h1>
</div>
<ToastReservaExitosa Mostrar="mostrarToastReserva"
                     Titulo="Nueva reserva"
                     Mensaje="@mensajeToastReserva" />
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
            <p class="text-secondary small fw-bold mb-1">Usuarios totales</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-1 fw-bold text-success">1024</span>
                <span class="fs-2"><img src="usuarios.png" alt="Usuarios" style="width: 100%; height: 100%; object-fit: contain;" /></span>
            </div>
            <p class="text-success small mt-2 mb-0 fw-semibold">+ 18% Respecto al mes anterior</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
            <p class="text-secondary small fw-bold mb-1">Canchas registradas</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-1 fw-bold text-success">1024</span>
                <span class="fs-2"><img src="ubicacion.png" alt="Ubicacion" style="width: 100%; height: 100%; object-fit: contain;" /></span>
            </div>
            <p class="text-success small mt-2 mb-0 fw-semibold">+ 5% Respecto al mes anterior</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
            <p class="text-secondary small fw-bold mb-1">Reservas del mes</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-1 fw-bold text-success">2048</span>
                <span class="fs-2"><img src="calendario.png" alt="Calendario" style="width: 100%; height: 100%; object-fit: contain;" /></span>
            </div>
            <p class="text-success small mt-2 mb-0 fw-semibold">+ 32% Respecto al mes anterior</p>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm p-4 bg-white rounded-4 h-100">
            <p class="text-secondary small fw-bold mb-1">Ingresos totales</p>
            <div class="d-flex justify-content-between align-items-center">
                <span class="fs-2 fw-bold text-success">s/.20 mil</span>
                <span class="fs-2"><img src="ingresos.png" alt="Ingresos" style="width: 100%; height: 100%; object-fit: contain;" /></span>
            </div>
            <p class="text-success small mt-2 mb-0 fw-semibold">+ 18% Respecto al mes anterior</p>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm p-4 bg-white rounded-4">
    <h5 class="fw-bold text-dark mb-4">Ocupación por horario</h5>
    
    <div class="d-flex align-items-end justify-content-between pt-4 px-2" style="height: 300px; border-bottom: 2px solid #E2E8F0; border-left: 2px solid #E2E8F0;">
        @foreach (var punto in DatosGrafico)
        {
            <div class="d-flex flex-column align-items-center flex-grow-1 mx-2" style="max-width: 60px;">
                <div class="w-100 rounded-top-2 translate-bar-animation" 
                     style="height: @(punto.Porcentaje)px; background-color: #48BE74;" 
                     title="Ocupación: @punto.Porcentaje">
                </div>
                <span class="text-secondary mt-2 small fw-semibold" style="font-size: 11px;">@punto.Hora</span>
            </div>
        }
    </div>
</div>

<style>
    .translate-bar-animation {
        transition: height 0.5s ease-in-out;
    }
    .translate-bar-animation:hover {
        background-color: #059669 !important;
        cursor: pointer;
    }
</style>