@page "/Portal/MisReservas"  
@rendermode InteractiveServer
@using CanchaLibreWeb.ViewModels
@using CanchaLibreWeb.Components.Pages.MisReservas
@attribute [Authorize(Roles = "Cliente")]

@layout Layout.OnlyNavMenu

@if (cargando)
{
    <div class="text-center p-5 w-100">
        <div class="spinner-border text-success" role="status"></div>
        <p class="mt-2 text-muted">Cargando tus reservas...</p>
    </div>
}
else
{
<div class="reservas-shell-global">

    <div class="reservas-contenido py-4">
        <div class="reservas-header">
            <div>
                <h1>Mis Reservas</h1>
                <p>Administrar mis reservas.</p>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(mensajeError))
        {
            <div class="alert alert-danger">@mensajeError</div>
        }

        <div class="lista-reservas">
            @if (reservasUsuario == null || !reservasUsuario.Any())
            {
                <div class="sin-reservas">
                    <p>No tienes ninguna reserva registrada actualmente.</p>
                    <a href="/EncuentraCancha" class="btn-buscar">Buscar Canchas</a>
                </div>
            }
            else
            {
                @foreach (var reserva in reservasUsuario)
                {
                    var bloque = reserva.bloques?.FirstOrDefault();
                    var totalPrecio = reserva.bloques?.Sum(b => b.precio) ?? 0;
                    var horario = bloque != null ? $"{bloque.horaInicio:HH:mm} - {bloque.horaFin:HH:mm}" : "---";
                    var fechaStr = bloque != null ? FormatearDia(bloque.diaSemana) : "---";

                    <div class="card-reserva-item">
                        <div class="reserva-imagen">
                            <img src="@(reserva.cancha?.imagenUrl ?? "cancha1.jpg")" alt="@reserva.cancha?.nombre" />
                        </div>

                        <div class="reserva-info">
                            <h3>@(reserva.cancha?.nombre ?? "---")</h3>
                            <p class="reserva-ubicacion"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i> @(reserva.cancha?.direccion ?? "---")</p>
                            <p class="reserva-fecha-hora">
                                <strong>
                                    <i class="fa-solid fa-calendar-days me-1" aria-hidden="true"></i> @fechaStr — <i class="fa-solid fa-clock me-1" aria-hidden="true"></i>@horario
                                </strong>
                            </p>
                            <p class="reserva-precio"><strong>S/ @totalPrecio.ToString("F2")</strong></p>
                        </div>

                        <div class="reserva-meta">
                            <span><strong>Booking ID:</strong> RES-@reserva.idReserva.ToString("D6")</span>
                            @if (reserva.pago?.idPago > 0)
                            {
                                <span><strong>Transaction:</strong> @reserva.pago.idPago</span>
                            }
                            <span class="estado-badge estado-@reserva.estado.ToString().ToLower()">
                                @(reserva.estado switch
                                {
                                    EstadoReservaEnum.PENDIENTE_PAGO => "Pendiente de pago",
                                    EstadoReservaEnum.CONFIRMADA => "Confirmada",
                                    EstadoReservaEnum.CANCELADA => "Cancelada",
                                    EstadoReservaEnum.RECHAZADA => "Rechazada",
                                    _ => reserva.estado.ToString()
                                })
                            </span>
                        </div>

                        <div class="reserva-acciones">
                            <button class="btn-detalle" @onclick="() => VerDetalle(reserva.idReserva)">Ver detalle</button>
                            @if (reserva.estado == EstadoReservaEnum.PENDIENTE_PAGO)
                            {
                                <button class="btn-cancelar" @onclick="() => CancelarReserva(reserva.idReserva)">Cancelar</button>
                            }
                            else
                            {
                                <button class="btn-cancelar" @onclick="() => CancelarReserva(reserva.idReserva)">Eliminar</button>
                            }
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
}

@if (mostrarModalDetalle && reservaDetalle != null)
{
    var bloqueModal = reservaDetalle.bloques?.FirstOrDefault();
    var horarioModal = bloqueModal != null ? $"{bloqueModal.horaInicio:HH:mm} - {bloqueModal.horaFin:HH:mm} hrs" : "---";
    var fechaModal = bloqueModal != null ? FormatearDia(bloqueModal.diaSemana) : "---";
    var precioModal = reservaDetalle.bloques?.Sum(b => b.precio) ?? 0;
    var deportesStr = reservaDetalle.cancha?.deportes != null
        ? string.Join(", ", reservaDetalle.cancha.deportes.Select(d => d.ToString()))
        : "---";
    var etiquetasStr = reservaDetalle.cancha?.etiquetas != null
        ? string.Join(", ", reservaDetalle.cancha.etiquetas.Select(e => e.ToString()))
        : "---";

    <div class="modal-overlay" @onclick="CerrarModal">
        <div class="modal-contenido" @onclick:stopPropagation>
            <button class="modal-cerrar" @onclick="CerrarModal">&times;</button>

            <div class="modal-grid">
                <div class="modal-imagen">
                    <img src="@(reservaDetalle.cancha?.imagenUrl ?? "cancha1.jpg")" alt="@reservaDetalle.cancha?.nombre" />
                </div>

                <div class="modal-info">
                    <h2>@(reservaDetalle.cancha?.nombre ?? "---")</h2>
                    <p class="modal-ubicacion"><i class="fa-solid fa-location-dot me-1" aria-hidden="true"></i> @(reservaDetalle.cancha?.direccion ?? "---")</p>

                    <div class="modal-seccion">
                        <h3>Detalles de la cancha</h3>
                        <p><strong>Descripción:</strong> @(reservaDetalle.cancha?.descripcion ?? "---")</p>
                        <p><strong>Deportes:</strong> @deportesStr</p>
                        <p><strong>Etiquetas:</strong> @etiquetasStr</p>
                        <p><strong>Calificación:</strong> ⭐ @(reservaDetalle.cancha?.promedioCalificacion.ToString("F1") ?? "---")</p>
                        <p><strong>Precio base:</strong> S/ @(reservaDetalle.cancha?.precioBase.ToString("F2") ?? "---")</p>
                    </div>

                    <div class="modal-seccion">
                        <h3>Detalles de la reserva</h3>
                        <p><strong>Booking ID:</strong> RES-@reservaDetalle.idReserva.ToString("D6")</p>
                        <p><strong>Estado:</strong>
                            <span class="estado-badge estado-@reservaDetalle.estado.ToString().ToLower()">
                                @(reservaDetalle.estado switch
                                {
                                    EstadoReservaEnum.PENDIENTE_PAGO => "Pendiente de pago",
                                    EstadoReservaEnum.CONFIRMADA => "Confirmada",
                                    EstadoReservaEnum.CANCELADA => "Cancelada",
                                    EstadoReservaEnum.RECHAZADA => "Rechazada",
                                    _ => reservaDetalle.estado.ToString()
                                })
                            </span>
                        </p>
                        <p><strong>Fecha:</strong> @fechaModal</p>
                        <p><strong>Horario:</strong> @horarioModal</p>
                        <p><strong>Monto:</strong> S/ @precioModal.ToString("F2")</p>
                        @if (reservaDetalle.pago?.idPago > 0)
                        {
                            <p><strong>Transacción:</strong> @reservaDetalle.pago.idPago</p>
                            <p><strong>Método de pago:</strong> @reservaDetalle.pago.metodoPago</p>
                        }
                    </div>
                </div>
            </div>

            <div class="modal-acciones">
                @if (mostrarPagoEnModal)
                {
                    <div class="pago-modal-contenido">
                        <h3>Selecciona método de pago</h3>
                        <div class="opciones-pago">
                            <label class="pago-opcion @(metodoPagoSeleccionado == MetodoPagoEnum.YAPE ? "activo" : "")">
                                <input type="radio" name="mp" value="YAPE"
                                       checked="@(metodoPagoSeleccionado == MetodoPagoEnum.YAPE)"
                                       @onchange="() => metodoPagoSeleccionado = MetodoPagoEnum.YAPE" />
                                <span class="pago-icono">📱</span> YAPE
                            </label>
                            <label class="pago-opcion @(metodoPagoSeleccionado == MetodoPagoEnum.PLIN ? "activo" : "")">
                                <input type="radio" name="mp" value="PLIN"
                                       checked="@(metodoPagoSeleccionado == MetodoPagoEnum.PLIN)"
                                       @onchange="() => metodoPagoSeleccionado = MetodoPagoEnum.PLIN" />
                                <span class="pago-icono"><i class="fa-light fa-credit-card"></i></span> PLIN
                            </label>
                        </div>

                        @if (!string.IsNullOrEmpty(mensajePago))
                        {
                            <div class="alert alert-danger mt-2">@mensajePago</div>
                        }

                        <div class="pago-acciones">
                            <button class="btn-pagar-modal" @onclick="PagarReservaEnModal" disabled="@procesandoPago">
                                @(procesandoPago ? "Procesando..." : $"Pagar S/ {(reservaDetalle.bloques?.Sum(b => b.precio) + 5.00 ?? 0):F2}")
                            </button>
                            <button class="btn-cancelar-pago" @onclick="CancelarPagoEnModal" disabled="@procesandoPago">Volver</button>
                        </div>
                    </div>
                }
                else if (pagoExitoso)
                {
                    <div class="pago-exitoso-modal">
                        <p>✅ Pago realizado con éxito.</p>
                    </div>
                }
                else
                {
                    @if (reservaDetalle.estado == EstadoReservaEnum.PENDIENTE_PAGO)
                    {
                        <button class="btn-pagar-modal" @onclick="MostrarPagoEnModal">Pagar ahora</button>
                        <button class="btn-cancelar" @onclick="() => CancelarReserva(reservaDetalle.idReserva)">Cancelar reserva</button>
                    }
                    else
                    {
                        <button class="btn-cancelar" @onclick="() => CancelarReserva(reservaDetalle.idReserva)">Eliminar reserva</button>
                    }
                }
            </div>
        </div>
    </div>
}
