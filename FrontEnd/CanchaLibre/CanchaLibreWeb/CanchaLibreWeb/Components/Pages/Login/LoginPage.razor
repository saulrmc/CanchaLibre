@page "/Login"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@layout Layout.AuthLayout

<div class="login-box">
    @if (!mostrarRecuperacion)
    {
        <h1 class="app-title">Iniciar sesión</h1>
        <p class="app-subtitle">Ingrese su cuenta de CanchaLibre</p>

        <EditForm Model="@LoginModel" OnValidSubmit="ProcesarLogin" FormName="LoginForm">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label-custom">Usuario o correo electrónico</label>
                <InputText class="form-input-custom" @bind-Value="LoginModel.Correo" placeholder="usuario o correo@gmail.com" />
                <ValidationMessage For="@(() => LoginModel.Correo)" class="text-danger small mt-1" />
            </div>

            <div class="mb-3">
                <label class="form-label-custom">Contraseña</label>
                <div class="password-wrapper">
                    <InputText type="@(mostrarContrasena ? "text" : "password")" class="form-input-custom" @bind-Value="LoginModel.Contrasena" placeholder="**********" />
                    <button type="button" class="btn-ojo" @onclick="() => mostrarContrasena = !mostrarContrasena" tabindex="-1">
                        @if (mostrarContrasena)
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                <circle cx="12" cy="12" r="3" />
                            </svg>
                        }
                        else
                        {
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                <line x1="1" y1="1" x2="23" y2="23" />
                                <path d="M14.12 14.12a3 3 0 1 1-4.24-4.24" />
                            </svg>
                        }
                    </button>
                </div>
                <ValidationMessage For="@(() => LoginModel.Contrasena)" class="text-danger small mt-1" />
            </div>

            <div class="text-end mb-4">
                <button type="button" class="btn btn-link text-success p-0 small text-decoration-none" @onclick="() => AlternarVista(true)">
                    ¿Olvidó su contraseña?
                </button>
            </div>

            @if (!string.IsNullOrEmpty(mensajeError))
            {
                <div class="alert alert-danger py-2 small text-center mb-3">@mensajeError</div>
            }

            <button class="btn btn-success w-100 py-2" type="submit">Iniciar sesión</button>
        </EditForm>

        <div class="text-center mt-4 text-muted small">
            ¿No tiene una cuenta? <a href="/Registrar" class="text-success text-decoration-none">Regístrese</a>
        </div>
    }
    else
    {
        <!-- [El formulario de recuperación se mantiene igual que antes] -->
        <h1 class="app-title">Recuperar Contraseña</h1>
        <EditForm Model="@RecuperarModel" OnValidSubmit="ProcesarRecuperacion" FormName="RecoveryForm">
            <DataAnnotationsValidator />
            <div class="mb-4">
                <label class="form-label-custom">Correo electrónico registrado</label>
                <InputText type="email" class="form-input-custom" @bind-Value="RecuperarModel.Correo" placeholder="correo@ejemplo.com" />
                <ValidationMessage For="@(() => RecuperarModel.Correo)" class="text-danger small mt-1" />
            </div>
            @if (!string.IsNullOrEmpty(mensajeStatus))
            {
                <div class="alert @(esErrorStatus ? "alert-danger" : "alert-success") py-2 small text-center mb-3">@mensajeStatus</div>
            }
            <button class="btn btn-success w-100 mb-2" type="submit">Verificar Correo</button>
            <button class="btn btn-light w-100" type="button" @onclick="() => AlternarVista(false)">Volver al Login</button>
        </EditForm>
    }
    //
    <BloqueoCuentaModal Mostrar="mostrarBloqueo"
                        SegundosIniciales="segundosBloqueo"
                        OnFinalizado="@(() => mostrarBloqueo = false)" />//
</div>